# designer-plan-site Netlify Functions env vars
# Copy to .env (gitignored) for local `netlify dev`, and set the same in
# the Netlify dashboard → Site → Environment variables for production.

# ---- Supabase (used by popup-capture, account-bootstrap, cart-checkout) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Fulfillment Bridge HMAC (used by cart-checkout and future BFFs) ----
# Must match an entry in HmacKeyStore on the Spring Boot engine side.
# For local dev with Spring Boot localhost, use the dev secret from
# Designers/src/main/resources/application.properties.
HMAC_KEY_ID=netlify-prod
HMAC_SECRET=

# Where the fulfillment engine lives.
# Local dev:  http://localhost:8080
# Prod:       https://designerplan.io
ENGINE_BASE_URL=http://localhost:8080
